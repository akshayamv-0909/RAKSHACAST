# =========================================================
# RakshaCast Production Environment Configuration
# =========================================================

# App Metadata
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_BUILD=1
EXPO_PUBLIC_PACKAGE_NAME=com.rakshacast.app

# Official Live Data Gateways (IMD & Catchment Open Data)
EXPO_PUBLIC_IMD_GATEWAY_URL=https://mausam.imd.gov.in/api/v1/nowcast
EXPO_PUBLIC_RADAR_ENDPOINT=https://radar.imd.gov.in/products
EXPO_PUBLIC_OPEN_METEO_API=https://api.open-meteo.com/v1/forecast

# Backend API & Gateway Proxy
EXPO_PUBLIC_API_URL=https://api.rakshacast.in
EXPO_PUBLIC_WS_ENDPOINT=wss://api.rakshacast.in/realtime

# Map Services
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_PRODUCTION_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_OSM_TILE_SERVER=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# Offline Mesh Fallback (BLE / Wi-Fi Direct)
EXPO_PUBLIC_ENABLE_OFFLINE_MESH=true
EXPO_PUBLIC_MESH_SERVICE_UUID=6e400001-b5a3-f393-e0a9-e50e24dcca9e
